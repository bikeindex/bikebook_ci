#!/usr/bin/env bash
# bin/check_schema_change <bikebook checkout> <base> <head>
set -euo pipefail
cd "$1"
head=$3
base=$(git merge-base "$2" "$head")
changed=$(git diff --name-only --no-renames "$base" "$head")
grep -q '^schemas/' <<<"$changed" || exit 0

# The files at the paths on stdin, as of the commit given, fetched in one request: CI's checkout is a partial clone,
# where each file git grep reads is a request of its own, hours for a branch that edits every file
prefetch() {
  local missing
  missing=$(xargs -r git ls-tree "$1" -- | awk '{ print $3 }' |
    GIT_NO_LAZY_FETCH=1 git cat-file --batch-check | awk '$2 == "missing" { print $1 }')
  [ -z "$missing" ] || git -c fetch.negotiationAlgorithm=noop fetch -q --no-tags --no-write-fetch-head \
    --recurse-submodules=no --filter=blob:none origin --stdin <<<"$missing"
}

# A representative vehicle's linked components, and their bases, move to the new shape with it. A market variant's id
# names no file of its own, but its base's
linked() {
  [ -n "$2" ] || return 0
  prefetch "$head" <<<"$2"
  local paths existing
  paths=$({ git grep -h -o -E "\"$1\": \"c/[^\"]+\"" "$head" -- $2 || true; } |
    sed -E 's|.*"c/(.*)"|components/\1.json|' | sort -u)
  [ -n "$paths" ] || return 0
  existing=$(xargs git ls-tree --name-only "$head" -- <<<"$paths")
  while read -r path; do
    grep -q -x -F "$path" <<<"$existing" && echo "$path" || sed -E 's/[-_][a-z]{2}\.json$/.json/' <<<"$path"
  done <<<"$paths" | sort -u
}
# The base's list, so a branch can't add to its own
vehicles=$(git show "$base:representative_vehicles.csv" | awk -F, 'NR > 1 { print "vehicle_models/" substr($1, 3) ".json" }')
components=$(linked id "$vehicles")
bases=$(linked base "$components")
representative=$(printf '%s\n' $vehicles $components $bases)
# and so do their market overlays, moving into them
ids=$(sed -E 's|^vehicle_models/|m/|; s|^components/|c/|; s|\.json$||' <<<"$representative")
data=$(grep -E '^(vehicle_models|components)/' <<<"$changed" || true)
prefetch "$base" <<<"$data"
overlays=$({ xargs -r git grep -E '^  "base": "' "$base" -- <<<"$data" || true; } |
  sed -E 's/^[^:]+:([^:]+):  "base": "([^"]+)".*/\2 \1/' |
  awk 'NR == FNR { ids[$1]; next } $1 in ids { print $2 }' <(echo "$ids") -)
others=$(grep -E '^(vehicle_models|components|e_vehicle_classifications)/' <<<"$changed" |
  grep -v -x -F -f <(printf '%s\n' $representative $overlays) || true)
[ -z "$others" ] && exit 0
echo "A schema change edits no data file but the vehicles in representative_vehicles.csv, the components they link, those components' bases and their market overlays. This one also edits:"
echo "$others"
exit 1
