#!/usr/bin/env bash
# bin/test [cargo test arguments]: runs the checks
# bin/test --fix [<file or directory>...]: rewrites what the formatting and key order checks report, in every file or
# only those given
# Against BIKEBOOK_DATA, else the bikebook checkout this is cloned into
set -euo pipefail
unset CDPATH
ci=$(cd "$(dirname "$0")/.." && pwd)
if [ "$(git -C "$ci" branch --show-current)" = main ]; then
  # BatchMode, so a passphrase or host key prompt fails the probe instead of waiting
  ssh_command=${GIT_SSH_COMMAND:-$(git -C "$ci" config core.sshCommand || echo ssh)}
  latest=$(GIT_SSH_COMMAND="$ssh_command -o ConnectTimeout=5 -o BatchMode=yes" git -C "$ci" \
    -c http.lowSpeedLimit=1 -c http.lowSpeedTime=5 ls-remote origin refs/heads/main 2>/dev/null | cut -f1) || true
  if [ -n "$latest" ] && ! git -C "$ci" merge-base --is-ancestor "$latest" HEAD 2>/dev/null; then
    echo "bikebook_ci is out of date - please run: git -C $ci pull" >&2
    exit 1
  fi
fi
BIKEBOOK_DATA=$(cd "${BIKEBOOK_DATA:-$ci/..}" && pwd)
export BIKEBOOK_DATA
# From here, so a version manager reads .tool-versions
cd "$ci"
if [ "${1:-}" = --fix ]; then
  shift
  paths=()
  for path in "$@"; do
    [[ $path = /* ]] || path="$OLDPWD/$path"
    paths+=("$path")
  done
  exec cargo run --release --locked --bin fix -- ${paths[@]+"${paths[@]}"}
fi
exec cargo test --locked --no-fail-fast "$@"
